---
import Layout from "../layouts/Layout.astro";
import CardServicios from "../components/CardServicios.astro";
import Expandiblesection from "../components/Expandiblesection.astro";

import preguntasfrecuentes from "../config/preguntasfrecuentes.json";

import circuit from "../assets/images/circuit.jpeg";
import brazo from "../assets/images/brazo.jpg";
import io from "../assets/images/io.png";
import dash from "../assets/images/dash.jpg";
import onoff from "../assets/images/onoff.png";
import alerta from "../assets/images/alerta.png";

---

<Layout title="Prototipos, diseño y desarrollo de soluciones electrónicas." description="Proyectos electrónicos variados, desde sistemas de control hasta prototipos con microcontroladores PIC.">
	<!-- SECCION 1 -->
	<section
		class="relative my-9 min-h-96 flex justify-center mx-auto items-center lg:w-5/6 bg-[url('/images/flyb2.jpeg')] bg-cover bg-center rounded-2xl"
	>
		<div class="absolute inset-0 bg-black/50 rounded-2xl"></div>
		<div class="flex flex-col gap-y-10 w-3/4 items-center text-white">
			<span class="bg-black/50 px-3 py-1 rounded-lg backdrop-blur-sm">
			<h1	
				class="text-3xl sm:text-4xl lg:text-5xl ml-3 sm:pl-0 font-semibold tracking-tight text-center"
			>
				<span
					class="bg-gradient-to-r from-red-400 via-orange-500 to-blue-500 text-transparent bg-clip-text"
					>Ideas que se convierten en electrónica</span
				>
			</h1>
			<p class="text-lg text-gray-200 mt-4 ml-3 font-semibold">
				Prototipos, diseño y desarrollo de proyectos electrónicos.
			</p>
			</span>
			<p
				class="text-base sm:text-lg lg:text-xl text-white text-center max-w-2xl drop-shadow-md leading-relaxed tracking-tight"
			>
				Si estas de acuerdo con nuestra
				<a href="/notaPrivacidad" class="underline text-teal-300 hover:text-teal-200 font-semibold"
					>política de Privacidad</a
				>
				y con los
				<a href="/terminos" class="underline text-teal-300 hover:text-teal-200 font-semibold"
					>términos y condiciones</a
				>, coméntanos qué tipo de proyecto electrónico requieres.
			</p>
		</div>

	</section>

	<!-- SECCION 2 -->
	<section class="mt-7 mx-auto flex flex-col w-5/6 lg:w-full">
		<div class="grid xl:w-4/5 sm:grid-cols-3 lg:gap-10 xl:m-auto">
			<CardServicios
				title={"Control y teleoperación de brazos robóticos"}
				description={"Desarrollamos soluciones de control y teleoperación para brazos robóticos, integrando microcontroladores PIC, control PWM y joysticks para el manejo de movimientos. Ideal para proyectos de robótica, automatización y prototipos educativos o experimentales."}
				image={brazo}
			/>
			<CardServicios
				title={"Proyectos electrónicos con tarjetas impresas y protoboard"}
				description={"Diseñamos y desarrollamos prototipos y circuitos electrónicos utilizando componentes analógicos y digitales, tanto en protoboard como en tarjetas de circuito impreso (PCB). Implementamos prototipos adaptados a los requerimientos de cada proyecto."}
				image={circuit}
			/>
			<CardServicios
				title={"Proyectos IoT con PIC + aplicación web"}
				description={"Desarrollamos soluciones IoT basadas en microcontroladores PIC, integrando sensores para la adquisición de datos y su transmisión hacia un computador. La información recopilada se procesa y visualiza en una aplicación web, permitiendo el monitoreo de variables y el seguimiento de los datos en tiempo real."}
				image={io}
			/>
			<CardServicios
				title={"Encendido y apagado remoto de prototipos electrónicos"}
				description={"Desarrollamos sistemas para controlar el encendido y apagado de dispositivos de forma remota, mediante comunicación serial o Wi-Fi, utilizando microcontroladores PIC y ESP32. Ideal para prototipos electrónicos y proyectos de control remoto."}
				image={onoff}
			/>
			<CardServicios
				title={"Proyectos electrónicos para alertas y notificaciones"}
				description={"Desarrollamos sistemas de monitoreo y alerta basados en microcontroladores PIC, capaces de procesar datos recibidos mediante puerto serial y detectar automáticamente cuando los valores superan los umbrales establecidos. Ante una condición de alerta, el sistema puede enviar notificaciones a dispositivos móviles."}
				image={alerta}
			/>
		    <CardServicios
				title={"Desarrollo de software en C y microcontroladores PIC"}
				description={"Desarrollamos programas a medida en lenguaje C y soluciones en C para microcontroladores PIC, adaptadas a las necesidades de cada proyecto. Diseñamos aplicaciones embebidas, buscando soluciones eficientes y funcionales."}
				image={dash}
			/>
		</div>
	</section>

	<!-- SECCION 3 PREGUNTAS-->

	<section class="flex mt-20 mx-auto w-5/6 justify-around lg:w-full">
		<div class="hidden xl:block xl:w-2/5 pl-28 my-auto">
			<h1 class="text-4xl w-1/2 font-semibold">Preguntas frecuentes</h1>
		</div>
		<div class="flex flex-col w-full xl:w-3/5 px-3 gap-3 mb-3">
			{
				preguntasfrecuentes.map((pregunta) => (
					<Expandiblesection
						title={pregunta.title}
						description={pregunta.description}
					/>
				))
			}
		</div>
	</section>


	<!-- SECCION 4 CONTACTO -->
	<section id="contacto" class="w-full min-h-screen bg-gradient-to-b from-gray-50 to-gray-200 flex items-center justify-center p-6">
		<div class="w-full max-w-3xl h-[85vh] bg-white rounded-2xl shadow-2xl overflow-hidden">
		<iframe 
			src="https://formulario2026jye.netlify.app/?tokenn=IFR12AM3"
			class="w-full h-full border-0">
		</iframe>
		</div>
	</section>

		<!-- SECCION 5 WHATSAPP-->
		<a href="https://wa.me/51939404393"
			class="whatsapp-float"
			target="_blank"
			aria-label="Chat WhatsApp">
			<i class="fab fa-whatsapp"></i>
		</a>

</Layout>


<style>

.whatsapp-float{
    position: fixed;
    bottom: 20px;
    right: 20px;
	    background: #25d366;
    color: white;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 30px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    z-index: 9999;
    transition: 0.3s;
}

.whatsapp-float:hover{
	    background: #1ebe57;
    transform: scale(1.1);
}

/* Responsive móvil */
@media(max-width: 600px){

	.whatsapp-float{
        width: 55px;
        height: 55px;
        font-size: 26px;
        bottom: 15px;
        right: 15px;
    }

}

</style>